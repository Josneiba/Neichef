generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id
  email                 String               @unique
  name                  String
  householdSize         Int                  @default(1)
  dietaryPreferences    String[]
  notificationDaysAhead Int                  @default(3)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  pantryItems           PantryItem[]
  recipes               Recipe[]
  savedRecipes          SavedRecipe[]
  notifications         Notification[]
  budgetLedgerEntries   BudgetLedgerEntry[]
  nutritionPlans        NutritionPlan[]
  mealRoutines          MealRoutine[]
  shoppingListItems     ShoppingListItem[]
}

model ShoppingListItem {
  id              String   @id @default(cuid())
  userId          String
  name            String
  normalizedName  String
  ingredientId    String?
  quantity        Float    @default(1)
  unit            String?
  checked         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expectedCost    Float?   @default(0)

  @@index([userId, checked])
  @@index([normalizedName])
}

model Ingredient {
  id             String              @id @default(uuid())
  name           String              @unique
  category       String?
  estimatedPrice Float?              // Average price per standard unit (e.g., per pound, per item)
  unitType       String?             // e.g., "lbs", "oz", "count"
  PantryItem     PantryItem[]        @relation("IngredientToPantry")
  RecipeItem     RecipeIngredient[]  @relation("IngredientToRecipe")
  RegionalPrices IngredientPrice[]
}

model IngredientPrice {
  id           String     @id @default(uuid())
  ingredientId String
  countryCode  String
  currency     String
  averagePrice Float
  scanCount    Int        @default(1)
  lastUpdated  DateTime   @default(now())

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([ingredientId, countryCode])
}

model PantryItem {
  id              String               @id @default(cuid())
  userId          String
  name            String
  category        String
  quantity        Float
  unit            String
  purchaseDate    DateTime?
  openedDate      DateTime?
  expirationDate  DateTime
  location        String
  barcode         String?
  estimatedPrice  Float?
  addedDate       DateTime             @default(now())
  imageUrl        String?
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId    String?
  ingredient      Ingredient?          @relation("IngredientToPantry", fields: [ingredientId], references: [id], onDelete: SetNull)
  budgetEntries   BudgetLedgerEntry[]

  @@index([userId])
  @@index([ingredientId])
}

model Recipe {
  id                  String               @id @default(cuid())
  userId              String?
  source              String               @default("user")
  externalId          String?
  title               String
  description         String
  prepTimeMinutes     Int
  cookTimeMinutes     Int
  servings            Int
  difficulty          String
  tags                String[]
  imageUrl            String?
  costLevel           String
  isPublic            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients         RecipeIngredient[]
  steps               RecipeStep[]
  savedBy             SavedRecipe[]
  notifications       Notification[]
  mealSlots           MealSlot[]

  @@index([userId])
  @@index([source, externalId])
}

model RecipeIngredient {
  id            String       @id @default(cuid())
  recipeId      String
  name          String
  amount        Float
  unit          String
  substitution  String?
  ingredientId  String?
  ingredient    Ingredient?  @relation("IngredientToRecipe", fields: [ingredientId], references: [id], onDelete: SetNull)
  recipe        Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeStep {
  id               String  @id @default(cuid())
  recipeId         String
  step             Int
  instruction      String
  durationMinutes  Int?
  recipe           Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model SavedRecipe {
  userId    String
  recipeId  String
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@index([recipeId])
}

model Notification {
  id               String   @id @default(cuid())
  userId           String
  type             String
  title            String
  message          String
  itemId           String?
  recipeId         String?
  createdAt        DateTime @default(now())
  isRead           Boolean  @default(false)
  daysUntilExpiry  Int?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe           Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
}

model BudgetLedgerEntry {
  id            String      @id @default(cuid())
  userId        String
  pantryItemId  String?
  type          String
  amount        Float
  occurredAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pantryItem    PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model NutritionPlan {
  id                String                   @id @default(cuid())
  userId            String
  source            String                   // "upload_photo" | "upload_file" | "manual"
  status            String                   @default("active") // "active" | "archived"
  title             String
  notes             String?
  caloriesTarget    Int?
  proteinTargetG    Float?
  carbsTargetG      Float?
  fatTargetG        Float?
  mealsPerDay       Int?
  startDate         DateTime?
  endDate           DateTime?
  rawFileUrl        String?                  // original upload stored in Supabase Storage
  rawExtractedText  String?                  // OCR/parsed text for re-parsing
  extractionStatus  String                   @default("done") // "pending"|"processing"|"done"|"failed"|"needs_review"
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restrictions      NutritionRestriction[]
  routines          MealRoutine[]

  @@index([userId, status])
}

model NutritionRestriction {
  id             String        @id @default(cuid())
  planId         String
  type           String        // "allergy" | "avoid" | "limit" | "prefer"
  ingredientName String
  note           String?
  plan           NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model MealRoutine {
  id         String    @id @default(cuid())
  userId     String
  planId     String?   // null = user-defined routine, not tied to nutritionist plan
  name       String    // e.g., "Training day", "Rest day", "Bulking week"
  daysOfWeek String[]  // ["mon","wed","fri"]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       NutritionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  slots      MealSlot[]

  @@index([userId])
}

model MealSlot {
  id             String       @id @default(cuid())
  routineId      String
  mealType       String       // "breakfast" | "lunch" | "dinner" | "snack" | "pre_workout" | "post_workout"
  timeOfDay      String?      // e.g., "07:30"
  targetCalories Int?
  recipeId       String?
  freeText       String?      // e.g., "oats + whey + banana" when not linked to a recipe
  routine        MealRoutine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  recipe         Recipe?      @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([routineId])
}
